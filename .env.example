# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT BLOCK
# ─────────────────────────────────────────────────────────────────────────────
# Copy this section into your live server's .env and set real values. Never
# commit the real .env file. Keep placeholders below empty in version control.
#
# APP:
#   APP_ENV=production          (enables ForceHttps redirect + HSTS cookies)
#   APP_DEBUG=false             (never show stack traces on the live site)
#   APP_KEY=<generated key>     (run: php artisan key:generate on the server)
#   APP_URL=https://yourdomain.com
#
# HTTPS / COOKIES:
#   The app only enforces HTTPS when APP_ENV=production; local HTTP dev is
#   unaffected. In production, the session cookie must be sent over HTTPS:
#   SESSION_SECURE_COOKIE=true
#
# SESSION (keep lifetimes as-is unless changed deliberately; stay strict):
#   SESSION_DRIVER=database
#   SESSION_HTTP_ONLY=true
#   SESSION_SAME_SITE=lax
#   SESSION_LIFETIME=120
#
# MAIL (use an app-specific password; never reuse personal credentials):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.yourprovider.com
#   MAIL_PORT=587
#   MAIL_USERNAME=
#   MAIL_PASSWORD=
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=no-reply@yourdomain.com
#   MAIL_FROM_NAME="${APP_NAME}"
#
# DATABASE / CACHE / QUEUE:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=
#   DB_USERNAME=
#   DB_PASSWORD=
#   CACHE_STORE=database
#   QUEUE_CONNECTION=database